{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@cloudvoyant/helical-ui": ["../../libs/helical-ui/src/index.ts"],
      "@cloudvoyant/helical-react": ["../../libs/helical-react/src/index.ts"],
      "@cloudvoyant/helical-svelte": ["../../libs/helical-svelte/src/index.ts"],
      "@cloudvoyant/helical-svelte/table-of-contents": ["../../libs/helical-svelte/src/toc/TableOfContents.svelte"]
    }
  }
}
