---
import { getCollection, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';

export async function getStaticPaths() {
  const general = await getCollection('general');
  const components = await getCollection('components');
  return [
    ...general.map((entry) => ({
      params: { section: 'general', slug: entry.id },
      props: { entry },
    })),
    ...components.map((entry) => ({
      params: { section: 'components', slug: entry.id },
      props: { entry },
    })),
  ];
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const currentPath = `${import.meta.env.BASE_URL}${Astro.params.section}/${entry.id}`;
---

<Shell
  title={`${entry.data.title} — helical-ui`}
  description={entry.data.description}
  currentPath={currentPath}
>
  <h1 class="text-3xl font-bold tracking-tight">{entry.data.title}</h1>
  <div class="docs-prose mt-6">
    <Content />
  </div>
</Shell>
