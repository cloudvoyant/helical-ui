---
// apps/docs/src/pages/preview/sidebar/[example].astro
// Full-bleed preview route for the Sidebar demos, rendered inside an iframe by
// PreviewFrame.astro.
import Shell from '../../../layouts/Shell.astro';
import SidebarIconReact from '../../../components/examples/sidebar/icon/react.tsx';
import SidebarIconSvelte from '../../../components/examples/sidebar/icon/svelte.svelte';
import SidebarOffcanvasReact from '../../../components/examples/sidebar/offcanvas/react.tsx';
import SidebarOffcanvasSvelte from '../../../components/examples/sidebar/offcanvas/svelte.svelte';
import SidebarRailReact from '../../../components/examples/sidebar/rail/react.tsx';
import SidebarRailSvelte from '../../../components/examples/sidebar/rail/svelte.svelte';
import SidebarRightSideReact from '../../../components/examples/sidebar/right-side/react.tsx';
import SidebarRightSideSvelte from '../../../components/examples/sidebar/right-side/svelte.svelte';
import SidebarNestedReact from '../../../components/examples/sidebar/nested/react.tsx';
import SidebarNestedSvelte from '../../../components/examples/sidebar/nested/svelte.svelte';

export function getStaticPaths() {
  const EXAMPLES = ['icon', 'offcanvas', 'rail', 'right-side', 'nested'] as const;
  return EXAMPLES.map((example) => ({ params: { example } }));
}

const { example } = Astro.params;
const title = `Sidebar preview — ${example}`;
---

<Shell title={title} variant="preview">
  {example === 'icon' && (
    <div data-fw="react">
      <SidebarIconReact client:load />
    </div>
  )}
  {example === 'icon' && (
    <div data-fw="svelte">
      <SidebarIconSvelte client:load />
    </div>
  )}
  {example === 'offcanvas' && (
    <div data-fw="react">
      <SidebarOffcanvasReact client:load />
    </div>
  )}
  {example === 'offcanvas' && (
    <div data-fw="svelte">
      <SidebarOffcanvasSvelte client:load />
    </div>
  )}
  {example === 'rail' && (
    <div data-fw="react">
      <SidebarRailReact client:load />
    </div>
  )}
  {example === 'rail' && (
    <div data-fw="svelte">
      <SidebarRailSvelte client:load />
    </div>
  )}
  {example === 'right-side' && (
    <div data-fw="react">
      <SidebarRightSideReact client:load />
    </div>
  )}
  {example === 'right-side' && (
    <div data-fw="svelte">
      <SidebarRightSideSvelte client:load />
    </div>
  )}
  {example === 'nested' && (
    <div data-fw="react">
      <SidebarNestedReact client:load />
    </div>
  )}
  {example === 'nested' && (
    <div data-fw="svelte">
      <SidebarNestedSvelte client:load />
    </div>
  )}
</Shell>
