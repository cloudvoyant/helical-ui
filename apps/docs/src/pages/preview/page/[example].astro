---
// apps/docs/src/pages/preview/page/[example].astro
// Full-bleed preview route rendered inside an iframe by PreviewFrame.astro.
// Owns its own viewport, so 100svh / position: sticky resolve against the
// frame (like production) instead of the docs page.
import Shell from '../../../layouts/Shell.astro';
import PageDefaultReact from '../../../components/examples/page/default/react.tsx';
import PageDefaultSvelte from '../../../components/examples/page/default/svelte.svelte';
import PageGuttersReact from '../../../components/examples/page/gutters/react.tsx';
import PageGuttersSvelte from '../../../components/examples/page/gutters/svelte.svelte';
import PageGutterScrollReact from '../../../components/examples/page/gutter-scroll/react.tsx';
import PageGutterScrollSvelte from '../../../components/examples/page/gutter-scroll/svelte.svelte';
import PageFooterReact from '../../../components/examples/page/footer/react.tsx';
import PageFooterSvelte from '../../../components/examples/page/footer/svelte.svelte';
import PageLandingReact from '../../../components/examples/page/landing/react.tsx';
import PageLandingSvelte from '../../../components/examples/page/landing/svelte.svelte';

export function getStaticPaths() {
  const EXAMPLES = ['default', 'gutters', 'gutter-scroll', 'footer', 'landing'] as const;
  return EXAMPLES.map((example) => ({ params: { example } }));
}

const { example } = Astro.params;
const title = `Page preview — ${example}`;
---

<Shell title={title} variant="preview">
  {example === 'default' && (
    <div data-fw="react">
      <PageDefaultReact client:load />
    </div>
  )}
  {example === 'default' && (
    <div data-fw="svelte">
      <PageDefaultSvelte client:load />
    </div>
  )}
  {example === 'gutters' && (
    <div data-fw="react">
      <PageGuttersReact client:load />
    </div>
  )}
  {example === 'gutters' && (
    <div data-fw="svelte">
      <PageGuttersSvelte client:load />
    </div>
  )}
  {example === 'gutter-scroll' && (
    <div data-fw="react">
      <PageGutterScrollReact client:load />
    </div>
  )}
  {example === 'gutter-scroll' && (
    <div data-fw="svelte">
      <PageGutterScrollSvelte client:load />
    </div>
  )}
  {example === 'footer' && (
    <div data-fw="react">
      <PageFooterReact client:load />
    </div>
  )}
  {example === 'footer' && (
    <div data-fw="svelte">
      <PageFooterSvelte client:load />
    </div>
  )}
  {example === 'landing' && (
    <div data-fw="react">
      <PageLandingReact client:load />
    </div>
  )}
  {example === 'landing' && (
    <div data-fw="svelte">
      <PageLandingSvelte client:load />
    </div>
  )}
</Shell>
