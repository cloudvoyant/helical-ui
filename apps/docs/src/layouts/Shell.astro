---
import { getCollection } from 'astro:content';
import { NAV_GROUPS } from '../lib/nav';
import { Page, PageGutter, PageContent, PageFooter } from '@cloudvoyant/helical-react';
import '../styles/global.css';
import TopNav from '../components/TopNav.tsx';
import Sidebar from '../components/Sidebar.astro';
import Toc from '../components/Toc.astro';
import Footer from '../components/Footer.astro';

interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  headings?: TocHeading[];
  /** `landing` renders the Page landing variant (no gutters); `preview` renders a bare iframe canvas. */
  variant?: 'default' | 'landing' | 'preview';
}

const {
  title = 'helical-ui',
  description,
  currentPath = import.meta.env.BASE_URL,
  headings = [],
  variant = 'default',
} = Astro.props;

const isPreview = variant === 'preview';
const general = isPreview ? [] : (await getCollection('general')).sort((a, b) => a.data.order - b.data.order);
const components = isPreview ? [] : (await getCollection('components')).sort((a, b) => a.data.order - b.data.order);

const groups = NAV_GROUPS.map((g) => {
    const items = g.section === 'general' ? general : components.filter((c) => c.data.group === g.group);
    return {
      label: g.label,
      items: items.map((entry) => ({
        title: entry.data.title,
        href: `${import.meta.env.BASE_URL}${g.section}/${entry.id}`,
      })),
    };
  })
  .filter((g) => g.items.length > 0);
---

<!doctype html>
<html lang="en" data-framework="react" class="theme-helical-ui">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon-light.svg`} data-favicon="light" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon-dark.svg`} data-favicon="dark" />
    <link rel="alternate icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        try {
          var framework = localStorage.getItem('vortex:framework');
          if (framework === 'svelte' || framework === 'react') {
            document.documentElement.dataset.framework = framework;
          }
          // Restore the theme before first paint to avoid a flash.
          var root = document.documentElement;
          var mq = window.matchMedia('(prefers-color-scheme: dark)');
          var mode = localStorage.getItem('vortex:color-mode') || 'system';
          var dark = mode === 'dark' || (mode === 'system' && mq.matches);
          if (dark) root.classList.add('dark');
          var theme = localStorage.getItem('vortex:theme');
          // Default to the helical-ui brand theme when nothing is stored. Ignore
          // legacy 'light'/'dark' values left by the old theme toggle.
          if (!theme || theme === 'light' || theme === 'dark') theme = 'helical-ui';
          {
            var toRemove = [];
            for (var i = 0; i < root.classList.length; i++) {
              if (root.classList[i].indexOf('theme-') === 0) toRemove.push(root.classList[i]);
            }
            for (var j = 0; j < toRemove.length; j++) root.classList.remove(toRemove[j]);
            root.classList.add('theme-' + theme);
          }
          // Show the theme-appropriate favicon: `dark` class on <html> selects it.
          var favicons = document.querySelectorAll('link[rel="icon"][data-favicon]');
          var applyFavicon = function (isDark) {
            for (var k = 0; k < favicons.length; k++) {
              favicons[k].media = isDark ? 'not all' : 'all';
              favicons[k].setAttribute('media', isDark ? '(prefers-color-scheme: dark)' : '(prefers-color-scheme: light)');
            }
          };
          applyFavicon(dark);
          // Keep the favicon in sync when the theme toggles at runtime.
          var faviconObserver = new MutationObserver(function () {
            applyFavicon(document.documentElement.classList.contains('dark'));
          });
          faviconObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
        } catch (e) {}
      })();
    </script>
  </head>
  <body class:list={['bg-background text-foreground antialiased', isPreview && 'min-h-dvh overflow-hidden']}>
    {variant === 'preview' ? (
      <>
        <div data-demo>
          <slot />
        </div>
        <script is:inline>
          window.addEventListener('message', (event) => {
            if (event.origin !== location.origin) return;
            const data = event.data ?? {};
            if (data.framework === 'react' || data.framework === 'svelte') {
              document.documentElement.dataset.framework = data.framework;
            }
            const root = document.documentElement;
            if (typeof data.theme === 'string' && data.theme) {
              root.classList.forEach((cls) => {
                if (cls.startsWith('theme-')) root.classList.remove(cls);
              });
              root.classList.add(`theme-${data.theme}`);
            }
            if (data.dark === true) root.classList.add('dark');
            else if (data.dark === false) root.classList.remove('dark');
          });
        </script>
      </>
    ) : variant === 'landing' ? (
      <>
        <TopNav client:load currentPath={currentPath} groups={groups} />
        <Page variant="landing">
          <slot />
          <PageFooter>
            <Footer />
          </PageFooter>
        </Page>
      </>
    ) : (
      <>
        <TopNav client:load currentPath={currentPath} groups={groups} />
        <Page>
          <PageGutter
            side="left"
            className="top-16 hidden h-[calc(100svh-4rem)] lg:block lg:w-56 lg:p-0"
          >
            <div class="scroll-fade scroll-fade-20 no-scrollbar h-full w-full overflow-y-auto py-10 pl-4 lg:pl-8">
              <Sidebar currentPath={currentPath} />
            </div>
          </PageGutter>
          <PageContent className="pt-16 px-4 pb-10 md:px-8">
            <div class="mx-auto w-full max-w-4xl">
              <slot />
            </div>
          </PageContent>
          <PageGutter
            side="right"
            className="top-16 hidden h-[calc(100svh-4rem)] xl:block xl:w-64 xl:p-0"
          >
            <div class="scroll-fade scroll-fade-20 no-scrollbar h-full w-full overflow-y-auto py-10 pr-4 xl:pr-8">
              <Toc headings={headings} />
            </div>
          </PageGutter>
          <PageFooter>
            <Footer />
          </PageFooter>
        </Page>
      </>
    )}
  </body>
</html>
