---
import Demo from './Demo.astro';

interface Props {
  component: string;
  exclude?: string | string[];
  order?: string[];
}

const { component, exclude = [], order } = Astro.props;
const excluded = new Set(Array.isArray(exclude) ? exclude : [exclude]);

const reactFiles = import.meta.glob('../components/examples/*/*/react.tsx');

function titleFromId(id: string): string {
  return id
    .split('-')
    .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
    .join(' ');
}

const prefix = `../components/examples/${component}/`;
const entries = Object.keys(reactFiles)
  .filter((p) => p.startsWith(prefix))
  .map((p) => p.slice(prefix.length).split('/')[0]!)
  .filter((id) => !excluded.has(id))
  .sort((a, b) => (a < b ? -1 : a > b ? 1 : 0))
  .map((id) => ({ id, title: titleFromId(id) }));

if (order && order.length > 0) {
  const rank = new Map(order.map((id, i) => [id, i]));
  entries.sort((a, b) => {
    const ra = rank.get(a.id) ?? order.length;
    const rb = rank.get(b.id) ?? order.length;
    return ra !== rb ? ra - rb : a.id.localeCompare(b.id);
  });
}
---

<div class="flex flex-col gap-10">
  {
    entries.map((entry) => (
      <section class="flex flex-col gap-3">
        <h3 class="text-lg font-semibold tracking-tight">{entry.title}</h3>
        <Demo component={component} example={entry.id} />
      </section>
    ))
  }
</div>
