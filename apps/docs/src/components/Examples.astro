---
// apps/docs/src/components/Examples.astro
// Enumerates a component's demo directories straight from the filesystem, so
// there is no separate metadata manifest to keep in sync with the examples.
import Demo from './Demo.astro';

interface Props {
  component?: string;
  /** The example already shown in the intro — skip it here. */
  exclude?: string | string[];
}

const { component = 'button', exclude } = Astro.props;
const excludedExamples = new Set(Array.isArray(exclude) ? exclude : exclude ? [exclude] : []);

// Lazy glob over the example dirs — we only use the matched paths to derive
// each example's id and title; the modules are never imported here.
const examplePaths = import.meta.glob('./examples/*/*/react.tsx');

const titleFromId = (id: string) =>
  id
    .split('-')
    .map((s) => s.charAt(0).toUpperCase() + s.slice(1))
    .join(' ');

const entries = Object.keys(examplePaths)
  .map((p) => /\.\/examples\/([^/]+)\/([^/]+)\/react\.tsx$/.exec(p))
  .filter((m): m is RegExpExecArray => m !== null)
  .filter((m) => m[1] === component)
  .map((m) => ({ id: m[2], title: titleFromId(m[2]) }))
  .filter((e) => !excludedExamples.has(e.id));
---

<div class="flex flex-col gap-10">
  {entries.map((entry) => (
    <section class="flex flex-col gap-3">
      <h3 class="text-lg font-semibold tracking-tight">{entry.title}</h3>
      <Demo component={component} example={entry.id} />
    </section>
  ))}
</div>
