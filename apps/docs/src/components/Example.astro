---
// apps/docs/src/components/Example.astro
import { Code } from 'astro/components';
import ExampleScreen from './ExampleScreen.astro';

interface Props {
  id?: string;
  title: string;
  reactCode: string;
  svelteCode: string;
  /** Render the preview flush to the card edge (no padding) — for full-screen demos. */
  fullscreen?: boolean;
}

const { id = '', title, reactCode, svelteCode, fullscreen = false } = Astro.props;
const slug = id || title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const codeId = `example-${slug}-code`;
---

<div
  class="group/example w-full rounded-lg outline-none"
  data-example
  data-example-id={id || undefined}
  tabindex="0"
>
  <div class="flex flex-col rounded-lg border border-border bg-background transition-colors group-focus-visible/example:border-primary group-focus-visible/example:ring-2 group-focus-visible/example:ring-primary/25">
    <div data-example-preview class="rounded-t-lg bg-background outline-none" data-demo tabindex="-1">
      <ExampleScreen fullscreen={fullscreen}>
        <slot />
      </ExampleScreen>
    </div>

    <div class="overflow-hidden rounded-b-lg">
      <div id={codeId} data-example-code hidden data-demo>
        <div data-fw="react">
          <Code
            code={reactCode}
            lang="tsx"
            themes={{ light: 'github-light', dark: 'github-dark' }}
            defaultColor={false}
          />
        </div>
        <div data-fw="svelte">
          <Code
            code={svelteCode}
            lang="svelte"
            themes={{ light: 'github-light', dark: 'github-dark' }}
            defaultColor={false}
          />
        </div>
      </div>

      <button
        type="button"
        class="flex w-full items-center justify-center gap-1.5 border-t border-border bg-muted/40 px-4 py-2 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
        data-example-toggle
        aria-expanded="false"
        aria-controls={codeId}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          data-example-chevron
          class="transition-transform duration-200"
        >
          <path d="m6 9 6 6 6-6"></path>
        </svg>
        <span data-example-toggle-label>Show code</span>
      </button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('[data-example]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-example-toggle]');
    const code = root.querySelector<HTMLElement>('[data-example-code]');
    const label = root.querySelector<HTMLElement>('[data-example-toggle-label]');
    const chevron = root.querySelector<HTMLElement>('[data-example-chevron]');

    if (!toggle || !code) return;

    const open = () => {
      toggle.setAttribute('aria-expanded', 'true');
      code.hidden = false;
      if (label) label.textContent = 'Hide code';
      chevron?.classList.add('rotate-180');
    };

    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      code.hidden = true;
      if (label) label.textContent = 'Show code';
      chevron?.classList.remove('rotate-180');
    };

    toggle.addEventListener('click', () => (code.hidden ? open() : close()));
  });
</script>
