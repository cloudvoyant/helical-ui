---
import { getCollection } from 'astro:content';
import { NAV_GROUPS } from '../lib/nav';

interface Props {
  currentPath?: string;
}

const { currentPath = import.meta.env.BASE_URL } = Astro.props;

const general = (await getCollection('general')).sort((a, b) => a.data.order - b.data.order);
const components = (await getCollection('components')).sort((a, b) => a.data.order - b.data.order);

const groups = NAV_GROUPS;
---

<nav class="flex flex-col gap-8 text-sm" aria-label="Docs navigation">
  {groups.map((group) => {
    const items =
      group.section === 'general' ? general : components.filter((c) => c.data.group === group.group);
    return items.length > 0 ? (
      <div>
        <p class="mb-3 px-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{group.label}</p>
        <ul class="flex flex-col gap-0.5">
          {items.map((entry) => {
            const href = `${import.meta.env.BASE_URL}${group.section}/${entry.id}`;
            const active = currentPath === href;
            return (
              <li>
                <a
                  href={href}
                  class:list={[
                    'block rounded-md px-3 py-1.5 font-medium outline-none transition-colors',
                    active
                      ? 'bg-accent/60 text-primary focus-visible:bg-accent'
                      : 'text-muted-foreground hover:bg-accent/50 hover:text-foreground focus-visible:bg-accent focus-visible:text-foreground',
                  ]}
                >
                  {entry.data.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ) : null;
  })}
</nav>
