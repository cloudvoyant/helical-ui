{
  "name": "helical-ui-monorepo",
  "version": "0.19.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "helical-ui — UI component library monorepo (React + Svelte libs + docs app)",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "format": "prettier --write \"libs/*/{src,tests}/**/*.ts\" \"apps/*/{src,tests}/**/*.{ts,tsx,mjs}\"",
    "format:check": "prettier --check \"libs/*/{src,tests}/**/*.ts\" \"apps/*/{src,tests}/**/*.{ts,tsx,mjs}\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@semantic-release/changelog": "^6.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^12.0.0",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "semantic-release": "^24.0.0",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
