{
  "name": "@cloudvoyant/helical-react",
  "version": "0.25.0",
  "description": "helical-ui React UI components",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cloudvoyant/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editor": {
      "@cloudvoyant/source": "./src/editor/index.ts",
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "require": "./dist/editor/index.cjs"
    },
    "./*": {
      "@cloudvoyant/source": "./src/*.tsx",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --no-error-on-unmatched-pattern && tsc --noEmit",
    "lint:fix": "eslint src --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "manim-web": "catalog:",
    "mermaid": "catalog:",
    "shiki": "catalog:"
  },
  "peerDependenciesMeta": {
    "manim-web": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "dependencies": {
    "@ark-ui/react": "catalog:",
    "@cloudvoyant/helical-ui": "workspace:*",
    "@tanstack/charts": "catalog:",
    "@tanstack/react-hotkeys": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@zag-js/dismissable": "catalog:",
    "@zag-js/dom-query": "catalog:",
    "lucide-react": "catalog:"
  },
  "devDependencies": {
    "@types/katex": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "katex": "catalog:",
    "manim-web": "catalog:",
    "mermaid": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shiki": "catalog:"
  }
}
