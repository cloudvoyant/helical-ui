{
  "name": "@cloudvoyant/helical-ui",
  "version": "0.25.0",
  "description": "helical-ui shared component interfaces, cva variants, and theme",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cloudvoyant/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./commands": {
      "@cloudvoyant/source": "./src/command/index.ts",
      "types": "./dist/command/index.d.ts",
      "import": "./dist/command/index.js",
      "require": "./dist/command/index.cjs"
    },
    "./editor": {
      "@cloudvoyant/source": "./src/editor/index.ts",
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "require": "./dist/editor/index.cjs"
    },
    "./*.css": "./src/*.css",
    "./*": {
      "@cloudvoyant/source": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/theme.css",
    "src/themes.css",
    "src/components.css",
    "src/themes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src tests --no-error-on-unmatched-pattern && tsc --noEmit",
    "lint:fix": "eslint src tests --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@tanstack/charts": "catalog:",
    "@tanstack/hotkeys": "catalog:",
    "@tiptap/core": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@tiptap/suggestion": "catalog:",
    "@tiptap/extension-character-count": "catalog:",
    "@tiptap/extension-code-block-lowlight": "catalog:",
    "@tiptap/extension-color": "catalog:",
    "@tiptap/extension-heading": "catalog:",
    "@tiptap/extension-highlight": "catalog:",
    "@tiptap/extension-link": "catalog:",
    "@tiptap/extension-mention": "catalog:",
    "@tiptap/extension-placeholder": "catalog:",
    "@tiptap/extension-task-item": "catalog:",
    "@tiptap/extension-task-list": "catalog:",
    "@tiptap/extension-text-align": "catalog:",
    "@tiptap/extension-text-style": "catalog:",
    "@tiptap/extension-typography": "catalog:",
    "@tiptap/extension-underline": "catalog:",
    "@zag-js/collection": "catalog:",
    "@zag-js/dismissable": "catalog:",
    "@zag-js/dom-query": "catalog:",
    "@zag-js/focus-visible": "catalog:",
    "@zag-js/i18n-utils": "catalog:",
    "@zag-js/live-region": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "fzf": "catalog:",
    "katex": "catalog:",
    "lowlight": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "peerDependencies": {
    "manim-web": "catalog:",
    "mermaid": "catalog:",
    "shiki": "catalog:"
  },
  "peerDependenciesMeta": {
    "manim-web": {
      "optional": true
    },
    "mermaid": {
      "optional": true
    },
    "shiki": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/katex": "catalog:",
    "@types/node": "catalog:",
    "katex": "catalog:",
    "manim-web": "catalog:",
    "mermaid": "catalog:",
    "shiki": "catalog:",
    "vitest": "catalog:"
  }
}
